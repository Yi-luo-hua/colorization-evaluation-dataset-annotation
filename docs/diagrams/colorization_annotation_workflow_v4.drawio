          <mxGeometry x="515" y="365" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fixed" value="&lt;b&gt;固定A · 154张&lt;/b&gt;&lt;br&gt;仅标A命中 · severity为空&lt;br&gt;评分1.0&lt;br&gt;不做CV / 看板 / AI" style="whiteSpace=wrap;html=1;fillColor=#e6f5ed;strokeColor=#489d72;strokeWidth=2;fontColor=#245b40;fontFamily=Microsoft YaHei;fontSize=18;align=center;verticalAlign=middle;spacing=10;rounded=1;arcSize=12;" vertex="1" parent="1">
